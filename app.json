{
  "expo": {
    "name": "CalculatorApp",
    "slug": "CalculatorApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "calculatorapp",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.jpg",
        "backgroundImage": "./assets/splash.jpg",
        "monochromeImage": "./assets/splash.jpg"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
