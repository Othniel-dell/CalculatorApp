{
  "expo": {
    "name": "Calculator",
    "slug": "CalculatorApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "calculatorapp",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.jpg",
        "backgroundImage": "./assets/icon.jpg",
        "monochromeImage": "./assets/splash.jpg"
      },
      "package": "com.othniel123.CalculatorApp"
    },
    "web": {
      "favicon": "./assets/icon.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fbfae02e-98e5-4842-86f5-59c66387115a"
      }
    }
  }
}
